# systemd unit for the PR review bot.
#   sudo useradd --system --home /opt/prbot prbot
#   sudo install -o prbot -d /opt/prbot/data && sudo cp prbot /opt/prbot/
#   sudo cp deploy/prbot.service /etc/systemd/system/ && sudo systemctl enable --now prbot
#   journalctl -u prbot -f
[Unit]
Description=LLM pull request review bot
After=network-online.target
Wants=network-online.target

[Service]
User=prbot
WorkingDirectory=/opt/prbot
ExecStart=/opt/prbot/prbot -data /opt/prbot/data -listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/prbot/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
